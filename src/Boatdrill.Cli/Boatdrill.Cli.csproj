<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>boatdrill-cli</AssemblyName>
    <RootNamespace>Boatdrill.Cli</RootNamespace>
    <Description>Runs a Boatdrill drill from the command line: for scripts, and for checking the engine on any OS.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Boatdrill.Core\Boatdrill.Core.csproj" />
  </ItemGroup>

</Project>
